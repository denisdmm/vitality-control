{
  "name": "Vitality Control",

  "dockerComposeFile": "docker-compose.yml",
  "service": "vitality_app",
  "workspaceFolder": "/vitality-control",

  "remoteUser": "vitality",
  "updateRemoteUserUID": true,

  "containerEnv": {
    "DEV_CONTAINER": "true",
    "POSTGRES_HOST": "PS_vitality-control",
    "POSTGRES_PORT": "5432",
    "POSTGRES_DB": "vitalitydb",
    "POSTGRES_USER": "appuser",
    "POSTGRES_PASSWORD": "apppassword"
  },

  "forwardPorts": [4300, 5432, 5434],

  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "christian-kohler.npm-intellisense",
        "ms-ossdata.vscode-postgresql"
      ],

      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }

  // "postCreateCommand": "npm ci && npm run prisma:generate -w backend"
}
