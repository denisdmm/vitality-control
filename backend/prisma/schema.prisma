generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  PACIENTE
  MEDICO
  ADMINISTRADOR
}

enum PatientAuditAction {
  LINK_ADDED
  LINK_REMOVED
  PATIENT_TRANSFERRED
  CHART_VIEWED
}

enum HealthRecordStatus {
  SOLICITADO
  AGENDADO
  REALIZADO
}

enum PrescriptionStatus {
  ATIVA
  ENCERRADA
}

// ─────────────────────────────────────────────
// Usuários — origem: users/accounts/{id}
// ─────────────────────────────────────────────

model User {
  id                  String   @id @default(uuid())
  name                String   @unique
  passwordHash        String   @map("password_hash")
  fullName            String   @map("full_name")
  socialName          String?  @map("social_name")
  email               String?
  medicalRecordNumber String?  @map("medical_record_number")
  crm                 String?  @unique
  photoUrl            String?  @map("photo_url")
  role                Role     @default(PACIENTE)
  height              Float?
  inactivityTimeout   Int?     @map("inactivity_timeout")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  patientLinks   PatientDoctor[] @relation("patient")
  doctorLinks    PatientDoctor[] @relation("doctor")
  healthRecords  HealthRecord[]
  medications    Medication[]
  vaccines       Vaccine[]
  vitals         VitalScore[]

  notesAsPatient       ClinicalNote[]     @relation("notePatient")
  notesAuthored        ClinicalNote[]     @relation("noteAuthor")
  auditAsPatient       PatientAuditEvent[] @relation("auditPatient")
  auditPerformed       PatientAuditEvent[] @relation("auditActor")
  auditAsDoctor        PatientAuditEvent[] @relation("auditSubjectDoctor")

  prescriptionsAsPatient Prescription[] @relation("prescriptionPatient")
  prescriptionsAsDoctor  Prescription[] @relation("prescriptionDoctor")
  prescriptionsCreated  Prescription[] @relation("prescriptionAuthor")
  prescribedMedications  Medication[]   @relation("medicationPrescriber")

  @@map("users")
}

// N:N paciente↔médico — origem: users.accounts.{id}.doctorIds[]
model PatientDoctor {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  doctorId  String   @map("doctor_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  patient   User     @relation("patient", fields: [patientId], references: [id], onDelete: Cascade)
  doctor    User     @relation("doctor", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@index([doctorId])
  @@index([patientId])
  @@map("patient_doctors")
}

// Anotação clínica do prontuário — pertence ao paciente, não ao vínculo que a originou
model ClinicalNote {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  patient User @relation("notePatient", fields: [patientId], references: [id], onDelete: Cascade)
  author  User @relation("noteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

// Trilha única para mudanças de vínculo e para consulta de prontuário por terceiro
model PatientAuditEvent {
  id               String           @id @default(uuid())
  patientId        String           @map("patient_id")
  actorId          String           @map("actor_id")
  subjectDoctorId  String?          @map("subject_doctor_id")
  action           PatientAuditAction
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  patient          User             @relation("auditPatient", fields: [patientId], references: [id], onDelete: Cascade)
  actor            User             @relation("auditActor", fields: [actorId], references: [id], onDelete: Cascade)
  subjectDoctor    User?            @relation("auditSubjectDoctor", fields: [subjectDoctorId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@map("patient_audit_events")
}

model HealthRecord {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  name                 String
  type                 String
  requestDate          DateTime           @map("request_date") @db.Timestamptz
  examDate             DateTime?          @map("exam_date") @db.Timestamptz
  result               String?
  status               HealthRecordStatus @default(SOLICITADO)
  requestingDoctorName String?            @map("requesting_doctor_name")
  requestingDoctorCrm  String?            @map("requesting_doctor_crm")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subItems SubItem[]

  @@index([userId])
  @@map("health_records")
}

model SubItem {
  id        String @id @default(uuid())
  recordId  String @map("record_id")
  name      String
  result    String
  reference String

  record HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("sub_items")
}

// ADR-003: biometria diária unificada; períodos manhã/tarde/noite em JSONB
// origem: data/bloodPressure, data/glucose e data/weight
model VitalScore {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  date                 DateTime  @db.Date
  bloodPressurePeriods Json?      @map("blood_pressure_periods")
  glucosePeriods       Json?      @map("glucose_periods")
  weight               Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("vital_scores")
}

// Receituário — 1 PDF por receita, com medicamentos e horários de tomada
model Prescription {
  id              String             @id @default(uuid())
  patientId       String             @map("patient_id")
  doctorId        String?            @map("doctor_id")
  issuedAt        DateTime           @default(now()) @map("issued_at") @db.Timestamptz
  status          PrescriptionStatus @default(ATIVA)
  fileStoredName  String?            @map("file_stored_name")
  fileDisplayName String?            @map("file_display_name")
  fileMimeType    String?            @map("file_mime_type")
  fileSize        Int?               @map("file_size")
  createdById     String             @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  patient     User         @relation("prescriptionPatient", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User?        @relation("prescriptionDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("prescriptionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  medications Medication[]

  @@index([patientId, status])
  @@index([doctorId])
  @@map("prescriptions")
}

// origem: {uid}/medications — item do receituário
model Medication {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  prescriptionId String  @map("prescription_id")
  name           String
  dosage         String
  frequency      String
  continuousUse  Boolean @default(false) @map("continuous_use")
  durationDays   Int?    @map("duration_days")
  prescribedById String? @map("prescribed_by_id")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription         @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescribedBy User?                @relation("medicationPrescriber", fields: [prescribedById], references: [id], onDelete: SetNull)
  schedules    MedicationSchedule[]

  @@index([userId])
  @@index([prescriptionId])
  @@index([userId, continuousUse])
  @@map("medications")
}

// Horário de tomada "HH:mm" — mesmo horário vale para todos os dias
model MedicationSchedule {
  id           String @id @default(uuid())
  medicationId String @map("medication_id")
  time         String

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, time])
  @@map("medication_schedules")
}

// origem: {uid}/vaccines
model Vaccine {
  id                          String   @id @default(uuid())
  userId                      String   @map("user_id")
  vaccineName                 String   @map("vaccine_name")
  vaccinationDate             DateTime @map("vaccination_date") @db.Timestamptz
  seriesSchedule              String?  @map("series_schedule")
  intervalBetweenDoses        Int?     @map("interval_between_doses")
  intervalBetweenBoosterDoses Int?     @map("interval_between_booster_doses")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("vaccines")
}

// origem: sharedData/exams/{slug}
model ExamType {
  id    String @id @default(uuid())
  label String @unique

  @@map("exam_types")
}

// ADR-004: sharedData (singleton) com colunas tipadas
// origem: sharedData.healthIndices
model SharedData {
  id                   Int  @id @default(1)
  bpSystolic           Int? @map("bp_systolic")
  bpDiastolic          Int? @map("bp_diastolic")
  bpSystolicIdeal      Int? @map("bp_systolic_ideal")
  bpDiastolicIdeal     Int? @map("bp_diastolic_ideal")
  bpSystolicLimit      Int? @map("bp_systolic_limit")
  bpDiastolicLimit     Int? @map("bp_diastolic_limit")
  glucosePreLimit      Int? @map("glucose_pre_limit")
  glucoseDiabetesLimit Int? @map("glucose_diabetes_limit")

  @@map("shared_data")
}